node_modules/
dist/
playground/
.claude/settings.local.json
*.local
.env
.env.*

# assembled phase prompts — regenerable from paperSpec.js at any time
scratch/

# user papers
*.pdf

# root copies (tracked versions live in public/, which is what gets served)
/Background.png
/sciloupe-demo-*.gif

# local paper source folders (PDFs + raw supplementary data; crops and extracted data are committed instead)
papers/

# …except sample papers served to the reader (fancy in-app PDF viewer).
# Both the directory and the *.pdf rule above must be negated for git to
# re-include a file whose parent dir is otherwise ignored.
!public/papers/
!public/papers/*.pdf
